# Normalise line endings. CI and the web dev loop both run on Linux (WSL),
# so LF is the canonical form in the repository and in the working tree.
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF or they will not run under WSL/Linux CI
gradlew text eol=lf
*.sh text eol=lf

# Binary assets
*.jar binary
*.docx binary
*.ico binary
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
